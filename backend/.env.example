# Copy this file to .env for local development. Never commit .env.
DATABASE_URL=sqlite:///./aipulse.db
AI_MODE=mock
# Required when AI_MODE=live. Keep this value only in your local .env or secret store.
LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
# Use a unique, high-entropy value outside local development.
SECRET_KEY=replace-me-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173
